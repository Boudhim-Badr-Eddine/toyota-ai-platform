# ─── DATABASE (Supabase + Prisma) ─────────────────────────────────────────────
# Supabase → Project Settings → Connect → ORMs → "Transaction pooler" string
DATABASE_URL=""

# Supabase → Project Settings → Connect → ORMs → "Session pooler" or direct string
DIRECT_URL=""

# ─── SUPABASE CLIENT ──────────────────────────────────────────────────────────
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=""

# Supabase → Project Settings → API → anon public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase → Project Settings → API → service_role key (SECRET — server only!)
SUPABASE_SERVICE_ROLE_KEY=""

# ─── AI (Groq) ────────────────────────────────────────────────────────────────
# console.groq.com → API Keys
GROQ_API_KEY=""

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Your application URL (use http://localhost:3000 for local dev)
NEXTAUTH_URL="http://localhost:3000"

# Required for Auth.js on localhost / preview URLs
AUTH_TRUST_HOST="true"

# ─── EMAIL (Gmail SMTP — admin notifications) ─────────────────────────────────
# Gmail → Compte → Sécurité → Validation en 2 étapes → Mots de passe des applications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
GMAIL_USER="badreddineboudhim@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
# Where admin notifications are delivered (defaults to GMAIL_USER)
ADMIN_NOTIFICATION_EMAIL="badreddineboudhim@gmail.com"
SMTP_FROM="Toyota Maroc Platform <badreddineboudhim@gmail.com>"

# ─── ML SERVICE ───────────────────────────────────────────────────────────────
# FastAPI service URL (use http://localhost:8000 for local dev)
ML_SERVICE_URL="http://localhost:8000"

# Set to "true" to skip the Python service and always use the built-in fallback
# ML_USE_LOCAL="true"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Homepage hero — Cloudinary MP4 (override without redeploying code)
NEXT_PUBLIC_HERO_VIDEO_URL="https://res.cloudinary.com/de73zfmty/video/upload/v1780692824/ytmp3gg-youtube-2025-toyota-gr-supra-overview-toyota-media-cd0zyb-zsc8-001-1080p_peOQ6QCh_online-video-cutter.com_kycvow.mp4"
